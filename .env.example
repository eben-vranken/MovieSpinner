# Copy to .env and fill in.
#
# TMDB_READ_TOKEN is the only required value. It is free: sign in at
# https://www.themoviedb.org/settings/api and copy the "API Read Access Token"
# (the long eyJ... one, not the short v3 API key).
TMDB_READ_TOKEN=

# Optional. Only used by a couple of older code paths; the read token covers
# everything the app does day to day.
TMDB_API_KEY=

# Your country, as a two-letter code. Decides which streaming services the
# "where can I watch this" line on each card checks. BE, GB, US, DE, ...
TMDB_REGION=BE

# Optional. Your Letterboxd username, for the daily RSS sync that closes out a
# pick once the feed shows you watched it.
LETTERBOXD_USER=
